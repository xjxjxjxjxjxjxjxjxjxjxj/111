# ---- Never commit workflow runtime / private data ----
XGO-AutoLoop/
_autoloop/
downloads/
state/
logs/
video_inbox/

# ---- Python caches ----
__pycache__/
*.pyc
*.pyo

# ---- Run artifacts / media (must not be committed) ----
*.mp4
*.avi
*.mov
*.jsonl
*.partial.*
*.downloading

# ---- OS / editor ----
Thumbs.db
Desktop.ini
.vscode/
.idea/

# Keep runtime data private, but version the OpenCode execution layer so fixes
# to the supervisor/stop channel do not exist only in one ignored local folder.
!XGO-AutoLoop/
XGO-AutoLoop/*
!XGO-AutoLoop/opencode_side/
!XGO-AutoLoop/opencode_side/*.py
!XGO-AutoLoop/opencode_side/tests/
!XGO-AutoLoop/opencode_side/tests/*.py
