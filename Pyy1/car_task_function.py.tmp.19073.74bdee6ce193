            my_car.arm.move_y_position(0.01 + 0.055 * j - (0.01 if water_num_ == 3 and j == 2 else 0))
            # my_car.move_to_detection_target_wt3(time_out=20.0)
            # my_car.move_distance([0.15,0,0], dis=0.01)  # 固定往前再走0.015
